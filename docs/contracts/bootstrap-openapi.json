{
  "components": {
    "schemas": {
      "DiagnosticBody": {
        "additionalProperties": false,
        "properties": {
          "duration_seconds": {
            "default": 1,
            "maximum": 30.0,
            "minimum": 0.0,
            "title": "Duration Seconds",
            "type": "integer"
          }
        },
        "title": "DiagnosticBody",
        "type": "object"
      },
      "FixBody": {
        "additionalProperties": false,
        "properties": {
          "include_medium": {
            "default": true,
            "title": "Include Medium",
            "type": "boolean"
          },
          "rule_version": {
            "const": "fix-evidence-v1",
            "default": "fix-evidence-v1",
            "title": "Rule Version",
            "type": "string"
          }
        },
        "title": "FixBody",
        "type": "object"
      },
      "FixReviewBody": {
        "additionalProperties": false,
        "properties": {
          "expected_revision": {
            "minimum": 0.0,
            "title": "Expected Revision",
            "type": "integer"
          },
          "note": {
            "maxLength": 300,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Note",
            "type": "string"
          },
          "status": {
            "enum": [
              "confirmed",
              "rejected",
              "unreviewed"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "expected_revision",
          "note"
        ],
        "title": "FixReviewBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginBody": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginBody",
        "type": "object"
      },
      "ParseBody": {
        "additionalProperties": false,
        "properties": {
          "commit_limit": {
            "anyOf": [
              {
                "maximum": 10000000.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Commit Limit"
          }
        },
        "title": "ParseBody",
        "type": "object"
      },
      "RepositoryBody": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "RepositoryBody",
        "type": "object"
      },
      "RetryBody": {
        "additionalProperties": false,
        "properties": {},
        "title": "RetryBody",
        "type": "object"
      },
      "SZZBody": {
        "additionalProperties": false,
        "properties": {
          "algorithm_version": {
            "const": "baseline-szz-v1",
            "default": "baseline-szz-v1",
            "title": "Algorithm Version",
            "type": "string"
          },
          "as_of": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "fix_run_id": {
            "format": "uuid",
            "title": "Fix Run Id",
            "type": "string"
          }
        },
        "required": [
          "fix_run_id"
        ],
        "title": "SZZBody",
        "type": "object"
      },
      "SyncBody": {
        "additionalProperties": false,
        "properties": {},
        "title": "SyncBody",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
