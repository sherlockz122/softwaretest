# Copy to .env and replace all empty secrets. Do not commit .env.
DG_ENVIRONMENT=development
DG_MYSQL_HOST=127.0.0.1
DG_MYSQL_PORT=13306
DG_MYSQL_DATABASE=defectguard
DG_MYSQL_USER=defectguard
DG_MYSQL_PASSWORD=
DG_MYSQL_ROOT_PASSWORD=
DG_REDIS_HOST=127.0.0.1
DG_REDIS_PORT=16379
DG_REDIS_PASSWORD=
DG_SIGNING_KEY=
DG_FRONTEND_ORIGIN=http://127.0.0.1:5173
# Explicit one-time seed only. No default account/password. Never commit actual credentials.
DG_BOOTSTRAP_USERNAME=
DG_BOOTSTRAP_PASSWORD=

# Shared clone storage; local Windows deployment must stay on D.
DG_REPOSITORY_DATA_DIR=./runtime/repositories
# Maximum elapsed time per parsing attempt; data batches remain resumable.
DG_REPOSITORY_PARSE_TIMEOUT_SECONDS=1800
