*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# 数据与数据库（克隆的仓库数据、本地数据库不进版本控制）
data/
*.db
*.sqlite3

# 模型文件
models/*.joblib
models/*.pkl
models/*.pt

# IDE / 系统
.idea/
.vscode/
.DS_Store

# 前端依赖、构建和测试产物
node_modules/
dist/
coverage/
playwright-report/
test-results/

# 环境配置和运行工件；示例配置允许跟踪
.env
.env.*
!.env.example
!.env.*.example
/artifacts/
/runtime/
*.log

# 本机操作记录和凭据目录不进入共享仓库
/.codex/local-system/
.ssh/
*.key
*.pem

# 外部 Word 通用模板仅本地留存；Markdown 来源材料纳入跟踪
/softwarePrediction/*.docx

# 探针：克隆下来的仓库（体积大、可重建，不入库）
# 注意：probe/out/*.csv 是探针结论的原始证据，**要**入库，不在此列
probe/repos/

# 大结果文件（项目根目录的 out/）
out/*.csv
